/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\ModelView.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "파일(&F)"
    BEGIN
        MENUITEM "연출 재로딩",                      ID_APP_DRAMA_RELOAD
        MENUITEM "끝내기(&X)",                     ID_APP_EXIT
    END
    POPUP "배경색"
    BEGIN
        MENUITEM "   0.   0.   0",              ID_COLOR1, CHECKED
        MENUITEM "255.255.255",                 ID_COLOR2
        MENUITEM "125.125.125",                 ID_COLOR3
        MENUITEM "   0.174.239",                ID_COLOR4
        MENUITEM "255.247.153",                 ID_COLOR5
        MENUITEM "246.150.121",                 ID_COLOR6
    END
    POPUP "도움말(&H)"
    BEGIN
        MENUITEM "ModelView 정보(&A)...",         ID_APP_ABOUT
    END
END


