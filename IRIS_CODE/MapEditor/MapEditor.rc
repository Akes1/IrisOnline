/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\MapEditor.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "Load Project\tAlt+O",         ID_FILE_LOAD_PROJECT
        MENUITEM "Save Project\tAlt+S",         ID_FILE_SAVE_PROJECT
        MENUITEM "Save Screen Shot",            ID_FILE_SAVE_SCREEN_SHOT
        MENUITEM "Save Log",                    ID_FILE_SAVE_LOG
        MENUITEM SEPARATOR
        MENUITEM "Exit",                        ID_APP_EXIT
    END
    POPUP "Terrain"
    BEGIN
        MENUITEM "New\tCtrl+N",                 ID_TERRAIN_NEW
        MENUITEM "Open\tCtrl+O",                ID_TERRAIN_OPEN
        MENUITEM "Save\tCtrl+S",                ID_TERRAIN_SAVE
        MENUITEM "Save As",                     ID_TERRAIN_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "Clear Height Map",            ID_TERRAIN_CLEAR_HEIGHTMAP
        MENUITEM "Import Height Map\tCtrl+I",   ID_TERRAIN_IMPORT_HEIGHTMAP
        MENUITEM "Export Height Map\tCtrl+E",   ID_TERRAIN_EXPORT_HEIGHTMAP
        MENUITEM SEPARATOR
        MENUITEM "Clear Alpha Map",             ID_TERRAIN_CLEAR_ALPHAMAP
        MENUITEM "Import Alpha Map",            ID_TERRAIN_IMPORT_ALPHAMAP
        MENUITEM "Export Alpha Map",            ID_TERRAIN_EXPORT_ALPHAMAP
        MENUITEM SEPARATOR
        MENUITEM "Clear Color Map",             ID_TERRAIN_CLEAR_COLORMAP
        MENUITEM "Import Color Map",            ID_TERRAIN_IMPORT_COLORMAP
        MENUITEM "Export Color Map",            ID_TERRAIN_EXPORT_COLORMAP
        MENUITEM SEPARATOR
        MENUITEM "Adjust Height (Z)",           ID_TERRAIN_ADJUST_HEIGHT
    END
    POPUP "Scene"
    BEGIN
        MENUITEM "New\tShift+N",                ID_SCENE_NEW
        MENUITEM "Open\tShift+O",               ID_SCENE_OPEN
        MENUITEM "Add\tShift+A",                ID_SCENE_ADD
        MENUITEM "Save\tShift+S",               ID_SCENE_SAVE
        MENUITEM "Save As",                     ID_SCENE_SAVE_AS
        MENUITEM "Save Area As",                ID_SCENE_SAVE_AREA_AS
        MENUITEM "Save Object Group As",        ID_SCENE_SAVE_OBJECT_GROUP_AS
        MENUITEM SEPARATOR
        MENUITEM "Load Area Group",             ID_SCENE_LOAD_AREA_GROUP
        MENUITEM "Load Object Transform Script", ID_SCENE_LOAD_OBJECT_TRANSFORM_SCRIPT
        MENUITEM SEPARATOR
        MENUITEM "Adjust All Object Pos",       ID_SCENE_ADJUST_ALL_POS
        MENUITEM "Adjust All Object Size",      ID_SCENE_ADJUST_ALL_SIZE
    END
    POPUP "Sound"
    BEGIN
        MENUITEM "New",                         ID_SOUND_NEW
        MENUITEM "Open",                        ID_SOUND_OPEN
        MENUITEM "Save",                        ID_SOUND_SAVE
        MENUITEM "Save As",                     ID_SOUND_SAVEAS
    END
    POPUP "Edit"
    BEGIN
        MENUITEM "Undo\tCtrl+Z",                ID_EDIT_UNDO
        MENUITEM "Redo\tCtrl+Y",                ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Copy\tCtrl+C",                ID_EDIT_COPY
        MENUITEM "Select All\tCtrl+A",          ID_EDIT_SELECT_ALL
        MENUITEM "Deselect All\tCtrl+D",        ID_EDIT_DESELECT_ALL
        MENUITEM SEPARATOR
        MENUITEM "Change Background Color\tF9", ID_EDIT_CHANGE_BGCOLOR
    END
    MENUITEM "About...",                    ID_APP_ABOUT
END

