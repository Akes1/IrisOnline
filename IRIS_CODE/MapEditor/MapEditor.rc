    "S",            ID_FILE_SAVE_PROJECT,   VIRTKEY, ALT, NOINVERT
    VK_F10,         ID_KEY_F10,             VIRTKEY, NOINVERT
    "A",            ID_SCENE_ADD,           VIRTKEY, SHIFT, NOINVERT
    "N",            ID_SCENE_NEW,           VIRTKEY, SHIFT, NOINVERT
    "O",            ID_SCENE_OPEN,          VIRTKEY, SHIFT, NOINVERT
