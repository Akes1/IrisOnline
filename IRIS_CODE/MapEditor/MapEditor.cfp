			<User>/EHsc /D &quot;_AFXDLL&quot; /D &quot;WIN32&quot; /D &quot;_DEBUG&quot; /D &quot;STRICT&quot; /D &quot;NIDEBUG&quot; /D &quot;MAP_EDITOR&quot; /Od /RTC1 /MDd /W4 /Zi /WX /Zc:wchar_t-</User>
		</RawOptionsRelease>
	</CompilerOptions>
	<LinkerOptions>
