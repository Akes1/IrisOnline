			</User>
		</LibsRelease>
		<RawOptionsDebug enabled="1">
			<Default>/DEBUG</Default>
			<User>/DEBUG /INCREMENTAL:NO /DEBUG /MACHINE:X86 Winmm.lib Version.lib ZipArchive_rm.lib dxguid.lib dinput8.lib NiAnimation.lib NIFloodgate.lib NiMain.lib NiSystem.lib NiDX9Renderer.lib NiMesh.lib NiCollision.lib NiMilesAudio.lib NiParticle.lib NiFont.lib mss32.lib</User>
		</RawOptionsDebug>
		<RawOptionsRelease enabled="0">
			<Default></Default>
			<User>/INCREMENTAL:NO /DEBUG /MACHINE:X86 Winmm.lib Version.lib ZipArchive_rm.lib dxguid.lib dinput8.lib NiAnimation.lib NIFloodgate.lib NiMain.lib NiSystem.lib NiDX9Renderer.lib NiMesh.lib NiCollision.lib NiMilesAudio.lib NiParticle.lib NiFont.lib mss32.lib</User>
		</RawOptionsRelease>
	</LinkerOptions>
	<Configs>
		<BuildLog enabled="0">$(CFRoot)\Build.log</BuildLog>
		<LibExt>lib;a</LibExt>
		<ObjExt>o;obj</ObjExt>
		<ResExt>res</ResExt>
