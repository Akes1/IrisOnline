				<Lib>user32.lib</Lib>
				<Lib>gdi32.lib</Lib>
				<Lib>winspool.lib</Lib>
				<Lib>comdlg32.lib</Lib>
				<Lib>advapi32.lib</Lib>
				<Lib>shell32.lib</Lib>
				<Lib>ole32.lib</Lib>
				<Lib>oleaut32.lib</Lib>
				<Lib>uuid.lib</Lib>
				<Lib>odbc32.lib</Lib>
				<Lib>odbccp32.lib</Lib>
			</User>
		</LibsDebug>
		<LibsRelease enabled="0">
			<Default>
				<Lib>kernel32.lib</Lib>
				<Lib>user32.lib</Lib>
				<Lib>gdi32.lib</Lib>
				<Lib>winspool.lib</Lib>
				<Lib>comdlg32.lib</Lib>
