				<Lib>user32.lib</Lib>
				<Lib>gdi32.lib</Lib>
				<Lib>winspool.lib</Lib>
				<Lib>comdlg32.lib</Lib>
				<Lib>advapi32.lib</Lib>
				<Lib>shell32.lib</Lib>
				<Lib>ole32.lib</Lib>
				<Lib>oleaut32.lib</Lib>
				<Lib>uuid.lib</Lib>
				<Lib>odbc32.lib</Lib>
				<Lib>odbccp32.lib</Lib>
			</Default>
			<User>
				<Lib>kernel32.lib</Lib>
				<Lib>user32.lib</Lib>
				<Lib>gdi32.lib</Lib>
				<Lib>winspool.lib</Lib>
				<Lib>comdlg32.lib</Lib>
				<Lib>advapi32.lib</Lib>
				<Lib>shell32.lib</Lib>
				<Lib>ole32.lib</Lib>
				<Lib>oleaut32.lib</Lib>
				<Lib>uuid.lib</Lib>
				<Lib>odbc32.lib</Lib>
				<Lib>odbccp32.lib</Lib>
			</User>
		</LibsDebug>
		<LibsRelease enabled="0">
			<Default>
				<Lib>kernel32.lib</Lib>
				<Lib>user32.lib</Lib>
				<Lib>gdi32.lib</Lib>
				<Lib>winspool.lib</Lib>
				<Lib>comdlg32.lib</Lib>
				<Lib>advapi32.lib</Lib>
				<Lib>shell32.lib</Lib>
				<Lib>ole32.lib</Lib>
				<Lib>oleaut32.lib</Lib>
				<Lib>uuid.lib</Lib>
				<Lib>odbc32.lib</Lib>
				<Lib>odbccp32.lib</Lib>
			</Default>
			<User>
				<Lib>kernel32.lib</Lib>
				<Lib>user32.lib</Lib>
				<Lib>gdi32.lib</Lib>
				<Lib>winspool.lib</Lib>
				<Lib>comdlg32.lib</Lib>
				<Lib>advapi32.lib</Lib>
				<Lib>shell32.lib</Lib>
				<Lib>ole32.lib</Lib>
				<Lib>oleaut32.lib</Lib>
				<Lib>uuid.lib</Lib>
				<Lib>odbc32.lib</Lib>
				<Lib>odbccp32.lib</Lib>
			</User>
		</LibsRelease>
		<RawOptionsDebug enabled="1">
			<Default>/DEBUG</Default>
			<User>/DEBUG /INCREMENTAL:NO /DEBUG /MACHINE:X86 Winmm.lib Version.lib ZipArchive_rm.lib dxguid.lib dinput8.lib NiAnimation.lib NIFloodgate.lib NiMain.lib NiSystem.lib NiDX9Renderer.lib NiMesh.lib NiCollision.lib NiMilesAudio.lib NiParticle.lib NiFont.lib mss32.lib</User>
		</RawOptionsDebug>
		<RawOptionsRelease enabled="0">
			<Default></Default>
			<User>/INCREMENTAL:NO /DEBUG /MACHINE:X86 Winmm.lib Version.lib ZipArchive_rm.lib dxguid.lib dinput8.lib NiAnimation.lib NIFloodgate.lib NiMain.lib NiSystem.lib NiDX9Renderer.lib NiMesh.lib NiCollision.lib NiMilesAudio.lib NiParticle.lib NiFont.lib mss32.lib</User>
		</RawOptionsRelease>
	</LinkerOptions>
	<Configs>
		<BuildLog enabled="0">$(CFRoot)\Build.log</BuildLog>
		<LibExt>lib;a</LibExt>
		<ObjExt>o;obj</ObjExt>
		<ResExt>res</ResExt>
	</Configs>
	<Commands msghandler="Vc.mhr">
		<Command name="C Compiler" io="1" rdos="0" sys="0">
			<Program enabled="1">cl.exe</Program>
			<Parameter enabled="1">/nologo -I$(IncPaths) $(CompilerOptions) /c &quot;$(FileName)&quot; /Fo&quot;$(Path)$(Name).obj&quot;</Parameter>
			<FileExt enabled="1">c</FileExt>
			<Target>$(PATH)$(NAME).obj</Target>
			<TargetType>obj</TargetType>
			<CurrentDir>$$(IDE)</CurrentDir>
			<EnvVar></EnvVar>
			<MsgID>Compiling $(FILENAME)...#81001</MsgID>
		</Command>
		<Command name="C++ Compiler" io="1" rdos="0" sys="0">
			<Program enabled="1">cl.exe</Program>
			<Parameter enabled="1">/nologo -I$(IncPaths) $(CompilerOptions) /c &quot;$(FileName)&quot; /Fo&quot;$(Path)$(Name).obj&quot;</Parameter>
			<FileExt enabled="1">cpp;cxx;c++;cc</FileExt>
			<Target>$(PATH)$(NAME).obj</Target>
			<TargetType>obj</TargetType>
			<CurrentDir>$$(IDE)</CurrentDir>
			<EnvVar></EnvVar>
			<MsgID>Compiling $(FILENAME)...#81001</MsgID>
		</Command>
		<Command name="Linker(CUI)" io="1" rdos="0" sys="0">
			<Program enabled="1">link.exe</Program>
			<Parameter enabled="1">/nologo $(LinkerOptions) /LIBPATH:$(LibPaths) /OUT:&quot;$(Target)&quot; $(Libs) $(ProjectFiles)</Parameter>
			<FileExt enabled="1">o;obj;a;lib;res</FileExt>
			<Target>$(Target)</Target>
			<TargetType>cui</TargetType>
			<CurrentDir>$$(IDE)</CurrentDir>
			<EnvVar></EnvVar>
			<MsgID>Linking...#81002</MsgID>
		</Command>
		<Command name="Linker(GUI)" io="1" rdos="0" sys="0">
			<Program enabled="1">link.exe</Program>
			<Parameter enabled="1">/nologo $(LinkerOptions) /subsystem:windows /LIBPATH:$(LibPaths) /OUT:&quot;$(Target)&quot; $(Libs) $(ProjectFiles)</Parameter>
			<FileExt enabled="1">o;obj;a;lib;res</FileExt>
			<Target>$(Target)</Target>
			<TargetType>gui</TargetType>
			<CurrentDir>$$(IDE)</CurrentDir>
			<EnvVar></EnvVar>
			<MsgID>Linking...#81002</MsgID>
		</Command>
		<Command name="Linker for DLL" io="1" rdos="0" sys="0">
			<Program enabled="1">link.exe</Program>
			<Parameter enabled="1">/nologo $(LinkerOptions) /DLL /LIBPATH:$(LibPaths) /OUT:&quot;$(Target)&quot; $(Libs) $(ProjectFiles) /DEF:$(DefFile)</Parameter>
			<FileExt enabled="1">o;obj;a;lib;res</FileExt>
			<Target>$(Target)</Target>
			<TargetType>dll</TargetType>
			<CurrentDir>$$(IDE)</CurrentDir>
			<EnvVar></EnvVar>
			<MsgID>Linking...#81002</MsgID>
		</Command>
		<Command name="Linker for Lib" io="1" rdos="0" sys="0">
			<Program enabled="1">link.exe</Program>
			<Parameter enabled="1">/LIB /nologo $(LinkerOptions) /LIBPATH:$(LibPaths) /OUT:&quot;$(Target)&quot; $(Libs) $(ProjectFiles)</Parameter>
			<FileExt enabled="1">o;obj</FileExt>
			<Target>$(Target)</Target>
			<TargetType>lib</TargetType>
			<CurrentDir>$$(IDE)</CurrentDir>
			<EnvVar></EnvVar>
			<MsgID>Linking...#81002</MsgID>
		</Command>
		<Command name="Resource Compiler" io="1" rdos="0" sys="0">
			<Program enabled="1">rc.exe</Program>
			<Parameter enabled="1">-I$(IncPaths) -Fo&quot;$(PATH)$(NAME).res&quot; &quot;$(FileName)&quot;</Parameter>
			<FileExt enabled="1">rc</FileExt>
			<Target>$(PATH)$(NAME).res</Target>
			<TargetType>res</TargetType>
			<CurrentDir>$$(IDE)</CurrentDir>
			<EnvVar></EnvVar>
			<MsgID>Compiling $(FILENAME)...#81001</MsgID>
		</Command>
		<Command name="Debugger" io="0" rdos="0" sys="0">
			<Program enabled="0">cdb.exe</Program>
			<Parameter enabled="0">cdebug.dll</Parameter>
			<FileExt enabled="1">exe;dll</FileExt>
			<Target></Target>
			<TargetType></TargetType>
			<CurrentDir></CurrentDir>
			<EnvVar></EnvVar>
			<MsgID>#81003</MsgID>
		</Command>
		<Command name="Run" io="0" rdos="0" sys="0">
			<Program enabled="0">$(Target)</Program>
			<Parameter enabled="0">$(Parameters)</Parameter>
			<FileExt enabled="1">exe</FileExt>
			<Target></Target>
			<TargetType></TargetType>
			<CurrentDir></CurrentDir>
			<EnvVar></EnvVar>
			<MsgID>#81004</MsgID>
		</Command>
		<Command name="Run DLL" io="0" rdos="0" sys="0">
			<Program enabled="0">$(HostApp)</Program>
			<Parameter enabled="0">$(Parameters)</Parameter>
			<FileExt enabled="1">dll</FileExt>
			<Target></Target>
			<TargetType></TargetType>
			<CurrentDir></CurrentDir>
			<EnvVar></EnvVar>
			<MsgID>#81004</MsgID>
		</Command>
		<Command name="Clean Objects" io="1" rdos="0" sys="0">
			<Program enabled="0">fdel.exe</Program>
			<Parameter enabled="1">&quot;$(Path)$(Name).obj&quot; $(FileName)</Parameter>
			<FileExt enabled="1">c;cpp;cxx;c++;cc</FileExt>
			<Target>$(Target)</Target>
			<TargetType></TargetType>
			<CurrentDir></CurrentDir>
			<EnvVar></EnvVar>
			<MsgID></MsgID>
		</Command>
		<Command name="Clean Resource" io="1" rdos="0" sys="0">
			<Program enabled="0">fdel.exe</Program>
			<Parameter enabled="1">&quot;$(Path)$(Name).res&quot; $(FileName)</Parameter>
			<FileExt enabled="1">rc</FileExt>
			<Target>$(Target)</Target>
			<TargetType></TargetType>
			<CurrentDir></CurrentDir>
			<EnvVar></EnvVar>
			<MsgID></MsgID>
		</Command>
		<Command name="Clean Io" io="1" rdos="0" sys="0">
			<Program enabled="0">fdel.exe</Program>
			<Parameter enabled="0">&quot;$(Path)$(Name).obj&quot; -silent</Parameter>
			<FileExt enabled="0">*.*</FileExt>
			<Target>$(Target)</Target>
			<TargetType></TargetType>
			<CurrentDir></CurrentDir>
			<EnvVar></EnvVar>
			<MsgID></MsgID>
		</Command>
		<Command name="Clean Target" io="1" rdos="0" sys="0">
			<Program enabled="0">fdel.exe</Program>
			<Parameter enabled="0">&quot;$(Target)&quot;</Parameter>
			<FileExt enabled="1">*.*</FileExt>
			<Target></Target>
			<TargetType></TargetType>
			<CurrentDir></CurrentDir>
			<EnvVar></EnvVar>
			<MsgID></MsgID>
		</Command>
	</Commands>
	<Actions>
		<Action name="Compile" depend="0">
			<File>
				<Command>"C Compiler""C++ Compiler""Resource Compiler"</Command>
			</File>
			<Project>
			</Project>
			<MsgID>Complete Compile $(FileName): $(Error) error(s), $(Warning) warning(s)\nGenerated $(Target)#81005</MsgID>
			<ErrMsgID>Complete Compile $(FileName): $(Error) error(s), $(Warning) warning(s)#81006</ErrMsgID>
			<PreAction></PreAction>
			<PostAction con="0"></PostAction>
		</Action>
		<Action name="Build" depend="0">
			<File>
				<Command>"C Compiler""C++ Compiler""Resource Compiler"</Command>
				<Command>"Linker(CUI)""Linker(GUI)""Linker for DLL""Linker for Lib"</Command>
			</File>
			<Project>
				<Command>"C Compiler""C++ Compiler""Resource Compiler"</Command>
				<Command>"Linker(CUI)""Linker(GUI)""Linker for DLL""Linker for Lib"</Command>
			</Project>
			<MsgID>Complete Build $(TargetName): $(Error) error(s), $(Warning) warning(s)\nGenerated $(Target)#81007</MsgID>
			<ErrMsgID>Complete Build $(TargetName): $(Error) error(s), $(Warning) warning(s)#81008</ErrMsgID>
			<PreAction></PreAction>
			<PostAction con="0"></PostAction>
		</Action>
		<Action name="Make" depend="1">
			<File>
				<Command>"C Compiler""C++ Compiler""Resource Compiler"</Command>
				<Command>"Linker(CUI)""Linker(GUI)""Linker for DLL""Linker for Lib"</Command>
			</File>
			<Project>
				<Command>"C Compiler""C++ Compiler""Resource Compiler"</Command>
				<Command>"Linker(CUI)""Linker(GUI)""Linker for DLL""Linker for Lib"</Command>
			</Project>
			<MsgID>Complete Make $(TargetName): $(Error) error(s), $(Warning) warning(s)\nGenerated $(Target)#81009</MsgID>
			<ErrMsgID>Complete Make $(TargetName): $(Error) error(s), $(Warning) warning(s)#81010</ErrMsgID>
			<PreAction></PreAction>
			<PostAction con="0"></PostAction>
		</Action>
		<Action name="Run" depend="0">
			<File>
				<Action>"Make"</Action>
				<Command>"Run""Run DLL"</Command>
			</File>
			<Project>
				<Action>"Make"</Action>
				<Command>"Run""Run DLL"</Command>
			</Project>
			<MsgID>#81011</MsgID>
			<ErrMsgID>#81012</ErrMsgID>
			<PreAction></PreAction>
			<PostAction con="0"></PostAction>
		</Action>
		<Action name="Debug" depend="0">
			<File>
				<Action>"Make"</Action>
				<Command>"Debugger"</Command>
			</File>
			<Project>
				<Action>"Make"</Action>
				<Command>"Debugger"</Command>
			</Project>
			<MsgID>#81013</MsgID>
			<ErrMsgID>#81014</ErrMsgID>
			<PreAction></PreAction>
			<PostAction con="0"></PostAction>
		</Action>
		<Action name="Clean" depend="0">
			<File>
				<Command>"Clean Objects""Clean Resource"</Command>
				<Command>"Clean Io"</Command>
				<Command>"Clean Target"</Command>
			</File>
			<Project>
				<Command>"Clean Objects""Clean Resource""Clean Io"</Command>
				<Command>"Clean Io"</Command>
				<Command>"Clean Target"</Command>
			</Project>
			<MsgID>Complete Clean $(TargetName)#81015</MsgID>
			<ErrMsgID>Clean $(TargetName) error#81016</ErrMsgID>
			<PreAction></PreAction>
			<PostAction con="0"></PostAction>
		</Action>
	</Actions>
</Builder>
<Builder name="FastDebug|Win32" type="Microsoft Visual Studio" version="1.0">
	<TargetName>MapEditor</TargetName>
	<TargetType>EXE</TargetType>
	<TargetDir>../cworking</TargetDir>
	<InterimDir>FastDebug</InterimDir>
	<IncPaths>
		<Path>D:\IRIS\Main_Dev\ZipArchive</Path>
		<Path>D:\IRIS\Main_Dev\Util</Path>
		<Path>D:\IRIS\Main_Dev\Util\STL</Path>
		<Path>"$(EGB_PATH)\sdk\Win32\Include"</Path>
		<Pattern>*\Microsoft SDK\Include</Pattern>
		<Pattern>*\VC\Include</Pattern>
		<Pattern>*\VC\atlmfc\Include</Pattern>
		<Pattern>*\VC\PlatformSDK\Include</Pattern>
		<Pattern>*\VC7\Include</Pattern>
		<Pattern>*\VC7\PlatformSDK\Include</Pattern>
		<Pattern>*\Vc7\atlmfc\include</Pattern>
		<Pattern>*\v6.0A\Include</Pattern>
	</IncPaths>
	<LibPaths>
		<Path>..\Lib</Path>
		<Path>"$(EGB_PATH)\SDK\Win32\Lib\VC80\ShippingLib"</Path>
		<Pattern>*\Microsoft SDK\Lib</Pattern>
		<Pattern>*\VC\Lib</Pattern>
		<Pattern>*\VC\atlmfc\Lib</Pattern>
		<Pattern>*\VC\PlatformSDK\Lib</Pattern>
		<Pattern>*\VC7\Lib</Pattern>
		<Pattern>*\VC7\PlatformSDK\Lib</Pattern>
		<Pattern>*\Vc7\atlmfc\lib</Pattern>
		<Pattern>*\v6.0A\Lib</Pattern>
	</LibPaths>
	<ExePaths>
		<Pattern>*\Microsoft SDK\Bin</Pattern>
		<Pattern>*\VC\Bin</Pattern>
		<Pattern>*\VC\PlatformSDK\Bin</Pattern>
		<Pattern>*\VC7\Bin</Pattern>
		<Pattern>*\VC7\PlatformSDK\Bin</Pattern>
		<Pattern>*\v6.0A\bin</Pattern>
		<Pattern>*\Debugging Tools for Windows (x86)</Pattern>
	</ExePaths>
	<AutoDetect>
		<Path>C:\Program Files\Microsoft Visual Studio 9.0</Path>
		<Path>D:\Program Files\Microsoft Visual Studio 9.0</Path>
		<Path>E:\Program Files\Microsoft Visual Studio 9.0</Path>
		<Path>F:\Program Files\Microsoft Visual Studio 9.0</Path>
		<Path>G:\Program Files\Microsoft Visual Studio 9.0</Path>
